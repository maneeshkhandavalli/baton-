{
  "name": "baton",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --import ./lib/contracts/__tests__/resolve-ts.mjs --test \"lib/contracts/__tests__/*.test.ts\"",
    "test:db": "node --import ./lib/contracts/__tests__/resolve-ts.mjs --test \"lib/db/__tests__/*.test.ts\"",
    "test:parsers": "node --import ./lib/contracts/__tests__/resolve-ts.mjs --test \"lib/parsers/__tests__/*.test.ts\" \"lib/privacy/__tests__/*.test.ts\"",
    "test:ui": "node --import ./lib/mocks/__tests__/resolve-ui.mjs --test \"lib/mocks/__tests__/*.test.ts\" \"components/shared/__tests__/*.test.ts\"",
    "test:sql": "bash supabase/tests/run.sh",
    "test": "npm run test:contracts && npm run test:db && npm run test:parsers && npm run test:ui && npm run test:ai && npm run test:actions && npm run test:pipeline && npm run test:integration",
    "test:ai": "node --import ./lib/ai/__tests__/resolve-ai.mjs --test \"lib/ai/__tests__/*.test.ts\"",
    "test:actions": "node --import ./lib/contracts/__tests__/resolve-ts.mjs --test \"lib/actions/__tests__/*.test.ts\"",
    "test:pipeline": "node --import ./lib/ai/__tests__/resolve-ai.mjs --test \"lib/pipeline/__tests__/*.test.ts\"",
    "test:integration": "node --import ./tests/integration/support/resolve.mjs --test \"tests/integration/**/*.test.ts\"",
    "test:integration:sql": "bash tests/integration/db/run.sh",
    "test:e2e": "node --import ./tests/integration/support/resolve.mjs --test tests/integration/e2e-pipeline.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
