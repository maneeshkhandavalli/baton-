# Baton environment variables (names only — never commit real values).
# Copy to .env.local for local development. See docs/architecture/shared-contracts.md §12.5.

# ── Supabase (use your own isolated development project) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Anon key or the newer publishable key (browser-safe; RLS applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Service-role (or secret) key, used by server actions and the pipeline worker.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (R8, §12.3) ─────────────────────────────────────────────────────────
# Bare https origin (http only for localhost). Missing or unsafe → magic links fail closed.
BATON_SITE_URL=http://localhost:3000

# ── Identity pepper (§12.11, D30) — SERVER ONLY, escrowed independently ─────
# Only version p1 is permitted. Parsing and previews fail closed without a verified pepper.
IDENTITY_PEPPER=
IDENTITY_PEPPER_VERSION=p1
# 64 lower-case hex: HMAC-SHA256(pepper, "baton:identity-pepper-canary:p1"). Non-secret registry value.
IDENTITY_PEPPER_CANARY=

# ── AI provider (D11 is OPEN: no production provider or model is chosen) ─────
# Leave AI_PROVIDER empty: processing then fails explicitly with "provider_not_configured".
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_EXTRACT=
AI_MODEL_VERIFY=
# Development/test only: AI_PROVIDER=fake plus BATON_ALLOW_FAKE_AI=1 enables the deterministic
# test adapter, and only when NODE_ENV is exactly "development" or "test" (unset or any other value
# refuses it). It performs NO real AI and is labelled as such in provenance.
BATON_ALLOW_FAKE_AI=

# ── Background worker (D10) ──────────────────────────────────────────────────
# Bearer secret for the pipeline drain / cron endpoint. Missing → the endpoint refuses.
CRON_SECRET=

# ── Erasure recovery manifest (D27 is OPEN) ──────────────────────────────────
# Not used yet: participant erasure and handover purge stay disabled (fail closed).
# ERASURE_MANIFEST_ENDPOINT=
# ERASURE_MANIFEST_CREDENTIALS=
# ERASURE_MANIFEST_ACTIVE_KEY_ID=
# ERASURE_MANIFEST_ACTIVE_KEY=
