# Baton environment variables (names only — never commit real values).
# Copy to .env.local for local development. See docs/architecture/shared-contracts.md §12.5.

# ── Supabase (use your own isolated development project) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Anon key or the newer publishable key (browser-safe; RLS applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Service-role (or secret) key, used by server actions and the pipeline worker.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (R8, §12.3) ─────────────────────────────────────────────────────────
# Bare https origin (http only for localhost). Missing or unsafe → magic links fail closed.
BATON_SITE_URL=http://localhost:3000

# ── Identity pepper (§12.11, D30) — SERVER ONLY, escrowed independently ─────
# Only version p1 is permitted. Parsing and previews fail closed without a verified pepper.
IDENTITY_PEPPER=
IDENTITY_PEPPER_VERSION=p1
# 64 lower-case hex: HMAC-SHA256(pepper, "baton:identity-pepper-canary:p1"). Non-secret registry value.
IDENTITY_PEPPER_CANARY=

# ── AI provider (D11: Google Gemini Developer API, free tier) ──────────────────
# AI_PROVIDER=gemini needs AI_API_KEY (server-only; never NEXT_PUBLIC_, never logged). The models
# default to gemini-3.6-flash when AI_MODEL_* are empty. Empty AI_PROVIDER → "provider_not_configured".
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_EXTRACT=
AI_MODEL_VERIFY=
# Development/test only: AI_PROVIDER=fake plus BATON_ALLOW_FAKE_AI=1 enables the deterministic
# test adapter, and only when NODE_ENV is exactly "development" or "test" (unset or any other value
# refuses it). It performs NO real AI and is labelled as such in provenance.
BATON_ALLOW_FAKE_AI=
# R3 Task 02: production builds (NODE_ENV=production) refuse a real provider unless the deployment declares an
# APPROVED data-governance profile. "gemini-paid-dpa" = the AI_API_KEY belongs to a Google Cloud project with an
# active billing account (Gemini "Paid Services": no product-improvement use; Data Processing Addendum). Owner
# approval required: docs/round3/privacy-and-data-protection.md. Unset in production → provider_not_configured.
AI_DATA_GOVERNANCE=

# ── Identity vault (R3 Task 02, PRIV-1) — SERVER ONLY ───────────────────────
# 32 random bytes as 64 hex characters (or base64), e.g. `openssl rand -hex 32`. Encrypts the [PERSON_n] →
# name mapping (AES-256-GCM). Escrow it like the pepper: losing it makes names unresolvable (content stays
# pseudonymous); missing → parse jobs fail closed (retryable). Version: k1.
IDENTITY_MAP_KEY=
IDENTITY_MAP_KEY_VERSION=k1
# Owner override ONLY: let sources parsed before pseudonymisation (plain-text names) go to the AI. Default off.
# BATON_ALLOW_LEGACY_IDENTITY_SOURCES=1

# ── Background worker (D10) ──────────────────────────────────────────────────
# Bearer secret for the pipeline drain / cron endpoint, and the key the database scheduler signs its
# dispatches with (≥ 32 characters). Missing or shorter → the endpoint refuses. docs/round3/autonomous-worker.md
CRON_SECRET=
# Concurrent worker sweeps across ALL entry points (scheduler, after() drains, page nudges, dev loop).
# Integer 1–4, default 1. Raise only after the AI provider's rate limits are verified.
# BATON_WORKER_MAX_SWEEPS=1

# ── Raw-upload retention (R3 Task 02, PRIV-2) ───────────────────────────────
# off (default) | dry_run | live. Any invalid value is off. Production activation needs owner approval.
# BATON_RETENTION_MODE=off
# Days an uploaded-but-unprocessed or failed-parse raw upload is kept (1–365, proposal: 7).
# BATON_RAW_RETENTION_DAYS=7
# Hours before an unfinished upload row or a failed post-parse delete is cleaned (2–168).
# BATON_PENDING_UPLOAD_GRACE_HOURS=24
# BATON_RETENTION_MAX_PER_RUN=100

# ── Erasure recovery manifest (D27 is OPEN) ──────────────────────────────────
# Not used yet: participant erasure and handover purge stay disabled (fail closed).
# ERASURE_MANIFEST_ENDPOINT=
# ERASURE_MANIFEST_CREDENTIALS=
# ERASURE_MANIFEST_ACTIVE_KEY_ID=
# ERASURE_MANIFEST_ACTIVE_KEY=
